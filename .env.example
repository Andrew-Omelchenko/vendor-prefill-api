# LOCAL DEVELOPMENT ONLY. Copy this to .env (which is gitignored) and fill it in.
# Real prod/staging secrets NEVER live in this file or in git — they live in
# AWS Secrets Manager. This template is safe to commit; .env is not.

# Which environment config to load locally: dev | staging | prod
CDK_ENV=dev

# Deployment target for `cdk deploy`
CDK_DEFAULT_REGION=eu-central-1
# CDK_DEFAULT_ACCOUNT is filled in automatically from your AWS credentials

# When exercising the vendor client locally, point at a sandbox endpoint
VENDOR_BASE_URL=https://sandbox.vendor.example.com
# A throwaway local key for offline testing only. The real keys are in
# Secrets Manager under vendor-prefill/<env>/vendor-api-key
VENDOR_API_KEY=local-dev-placeholder
